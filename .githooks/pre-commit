#!/bin/sh
# Refuses a commit unless it is authored as PartPriced Tools and its message carries no Claude attribution.
# Enable once per clone: git config core.hooksPath .githooks   (tests/node/attribution.test.mjs checks it is on)
name=$(git config user.name)
email=$(git config user.email)
if [ "$name" != "worksuite" ] || [ "$email" != "partpriced@users.noreply.github.com" ]; then
  echo "pre-commit: commits must be authored as PartPriced Tools <noreply@partpriced.com> (now: $name <$email>)." >&2
  echo "Fix with: git config user.name PartPriced Tools && git config user.email noreply@partpriced.com" >&2
  exit 1
fi
msg=$(git log -1 --format=%B 2>/dev/null)
exit 0
